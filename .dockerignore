# ─────────────────────────────────────────────────────────────────────────────
# 112 Simulator V2 — .dockerignore
# Excludes files that should NOT be sent to the Docker build context.
# This speeds up builds and prevents secrets / large binaries from leaking.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Git ──────────────────────────────────────────────────────────────────────
.git
.gitignore

# ─── Python artifacts ─────────────────────────────────────────────────────────
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.mypy_cache
*.egg-info
dist/
build/
.deps/

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env.local
.env
data/certs/
.env.*.local

# ─── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules
frontend/.next
frontend/out

# ─── Local databases (use Docker volume for persistence) ──────────────────────
*.db
data/112_simulator.db
data/backups/
data/tts_cache/
data/uploads/

# ─── GGUF model weights (provisioned separately; offline packager downloads Qwen)
# Keep weights and incomplete downloads out of application image layers.
*.gguf
*.gguf.part
*.gguf.lock
backend/core/qwen_tts/models/

# ─── IDE / OS artifacts ───────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo

# ─── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
worktrees/
data/checks/

# ─── Docker files (avoid recursive context issues) ───────────────────────────
docker_standalone/

# ─── TypeScript build cache ───────────────────────────────────────────────────
*.tsbuildinfo

.env.*
!.env.example
!.env.llm.example
data/reports/

.aws/
.codex/
.agents/
docs/

data/packages/
tools/tests/
backend/tests/
docker/offline/tests/
