# Template only: do not copy this file as a ready-to-run configuration.
# New installation: make init (generates unique secrets; never overwrites .env).
# Validate existing settings before building: make check-env
# Local backend uses SQLite. Compose overrides DATABASE_URL to its PostgreSQL service.
DATABASE_URL=sqlite+aiosqlite:///./data/112_simulator.db
# Required: unique random value, at least 32 characters; generated by make init.
SECRET_KEY=
# Defaults below apply only to a NEW PostgreSQL volume. For an existing database,
# keep its actual user/password/database (older installations used user admin).
# Changing these values does not update accounts or passwords in an existing volume.
POSTGRES_USER=simulator
POSTGRES_PASSWORD=
POSTGRES_DB=simulator112
INITIAL_ADMIN_USERNAME=admin
# Required for first startup; generated by make init. Never publish real passwords.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Администратор системы 112
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only this account can edit core security policies; override with comma-separated usernames.
# SECURITY_POLICY_ADMIN_USERNAMES=admin
FRONTEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=180
# Local backend -> optional local llama.cpp server. Container setting is separate.
DDS_LLM_BASE_URL=http://127.0.0.1:8081/v1
DDS_LLM_CONTAINER_BASE_URL=http://llm:8080/v1
DDS_LLM_MODEL=dds-qwen
GIGAAM_MODEL_PATH=./data/models/gigaam-v3-ctc-Q8_0.gguf
LLM_MODEL_PATH=./data/models/Qwen3.5-9B-Q4_K_M.gguf
LDAP_ENABLED=false
# Set directory service details only when explicitly enabling LDAP.
# LDAP_SERVER=ldaps://directory.example
# LDAP_DOMAIN=example
# LDAP_BASE_DN=dc=example
# TESTING is reserved for isolated tests. Never enable it in a deployment.
TTS_MODELS_DIR=./data/tts_models

# Speech synthesis is opt-in; the DDS offline delivery has no speech model requirement.
TTS_ENABLED=false
