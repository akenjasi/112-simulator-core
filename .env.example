# ─── 112 Simulator V2 — environment configuration ─────────────────────────────
# Copy this file to .env and fill in your values.
# The app reads these via os.getenv() — no dotenv library needed (use uvicorn --env-file).

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev, file on disk):
DATABASE_URL=sqlite+aiosqlite:///./data/112_simulator.db

# PostgreSQL (cloud / prod):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/simulator_db

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random key for production!
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-before-cloud-deploy

# Token lifetime in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Initial local administrator ──────────────────────────────────────────────
# Used only on the first startup when this username does not exist yet.
# Keep the real password in the ignored .env file; never commit it.
INITIAL_ADMIN_USERNAME=admin
# Optional comma-separated logins permitted to edit password/session/2FA policies.
# When omitted, only INITIAL_ADMIN_USERNAME has this permission; empty denies all.
# SECURITY_POLICY_ADMIN_USERNAMES=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Администратор системы 112

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── LLM (optional) ───────────────────────────────────────────────────────────
# Path to GGUF model file. Leave unset to use MockLlamaFallback (no GPU needed).
# LLM_MODEL_PATH=models/Qwen3.5-0.8B-Q8_0.gguf
# LLM_N_THREADS=4
# LLM_N_CTX=2048

# LDAP settings
LDAP_ENABLED=False
LDAP_SERVER=ldap://192.168.1.100
LDAP_DOMAIN=corp.local
LDAP_BASE_DN=dc=corp,dc=local

