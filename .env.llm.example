# ==============================================================================
# Local LLM Runtime Configuration Example (Task A-03)
#
# IMPORTANT SECURITY & GIT NOTICE:
# .env.* files are ignored; keep your real .env.llm private. Do NOT publish it
# with installation credentials or private local paths.
# Store your active configuration file outside the repository, for example:
#   /path/to/external/.env.llm
# And pass it to Compose:
#   make llm-up LLM_ENV_FILE=/path/to/external/.env.llm
# ==============================================================================

# 1. Host path to local GGUF model for docker/compose/llm.yml
# Must point to an existing local GGUF file on the host machine.
# DO NOT commit real GGUF weights to git.
DDS_LLM_MODEL_PATH=/absolute/path/Qwen3.5-9B-Q4_K_M.gguf

# 2. Backend service settings for DDS LLM report generation
# Base URL for OpenAI-compatible llama.cpp server:
# - When backend runs directly on host: http://127.0.0.1:8081/v1
# - When backend runs in a shared Docker network with llm container: http://llm:8080/v1
DDS_LLM_BASE_URL=http://127.0.0.1:8081/v1

# Model alias registered in llama.cpp server (--alias dds-qwen)
DDS_LLM_MODEL=dds-qwen

# Request timeout in seconds (positive finite float or int)
DDS_LLM_TIMEOUT_SECONDS=180

# Maximum allowed input snapshot length in characters (positive int)
DDS_LLM_MAX_INPUT_CHARS=24000

# Maximum output tokens budget for report generation (positive int)
DDS_LLM_MAX_TOKENS=1200
