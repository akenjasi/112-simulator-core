# install.sh generates secrets locally; it never copies development credentials.
INITIAL_ADMIN_USERNAME=admin
HTTP_PORT=3000
HTTPS_PORT=443
LLM_THREADS=4
LLM_CONTEXT=8192
LLM_TIMEOUT_SECONDS=900

# Reports: single backend process, co-located llama.cpp; MB values are MiB.
# queued: background scheduling; demo: immediate GPU inference without admission wait
DDS_REPORT_MODE=queued
DDS_REPORT_CPU_MAX_PERCENT=40
DDS_REPORT_IDLE_SECONDS=30
DDS_REPORT_RAM_RESERVE_MB=2048
DDS_REPORT_MODEL_BUDGET_MB=8192
DDS_REPORT_CANCEL_TIMEOUT_SECONDS=30
